# 라인 엔딩 정규화: 모든 텍스트 파일을 LF로 커밋
* text=auto eol=lf

# Python
*.py text eol=lf
*.pyi text eol=lf

# TypeScript / JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf

# Config
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.md text eol=lf

# Shell
*.sh text eol=lf

# Windows 전용
*.ps1 text eol=crlf
*.bat text eol=crlf

# 바이너리
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
