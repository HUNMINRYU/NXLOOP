# syntax=docker/dockerfile:1.7
# Backend 전용 Dockerfile (Cloud Run)
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_ROOT_USER_ACTION=ignore
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    fonts-noto-core \
    fontconfig \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -fv

WORKDIR /app

COPY pyproject.toml ./
COPY README.md ./
# BuildKit cache를 쓰면(Cloud Build에서 DOCKER_BUILDKIT=1) pip 설치가 반복될 때 훨씬 빨라진다.
RUN --mount=type=cache,target=/root/.cache/pip pip install .

COPY . .

ENV PYTHONPATH=/app/src

EXPOSE 8080
ENV PORT=8080

# Cloud Run이 주입하는 PORT 환경 변수를 사용 (미설정 시 8080)
CMD ["/bin/sh", "-c", "exec uvicorn app:app --host 0.0.0.0 --port ${PORT:-8080}"]
