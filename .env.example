# GCP Settings (Vertex AI 통합 인증)
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_CLOUD_LOCATION=global
GCS_BUCKET_NAME=your_bucket_name
GOOGLE_APPLICATION_CREDENTIALS=secrets.json
DATA_STORE_ID="your_data_store_id"
# RAG Data Stores (JSON format)
RAG_DATA_STORES={"search":"your_data_store_id","pipeline":"your_data_store_id","admin":"your_data_store_id","editor":"your_data_store_id"}

# Google API Key (YouTube, Gemini 공용 - Vertex AI 사용)
GOOGLE_API_KEY=your_google_api_key_here

# Naver Shopping API
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# AI Model Settings
GEMINI_TEXT_MODEL=gemini-3-pro-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
VEO_MODEL_ID=veo-3.1-fast-generate-001

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
OUTPUT_DIR=outputs

# Cloud Scheduler Settings
SCHEDULER_SERVICE_ACCOUNT=your-scheduler-sa@your-project.iam.gserviceaccount.com
SCHEDULER_LOCATION=asia-northeast3

# Notion API Settings
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Stripe Settings (결제 시스템 연동)
# - STRIPE_MODE: 'test' 또는 'live'. 테스트 환경에서는 반드시 'test'로 설정하세요.
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=pk_test_... # 프론트엔드용 테스트 공개 키
STRIPE_SECRET_KEY=sk_test_...      # 백엔드용 테스트 비밀 키
STRIPE_WEBHOOK_SECRET=whsec_...    # Stripe CLI 등으로 설정한 웹훅 시크릿

# System Settings
ENV=development # development, staging, production
SLACK_WEBHOOK_URL=  # 시스템 오류 및 결제 알림용 슬랙 웹훅 URL

# Development Helpers
# - TEST_EMAIL_ALLOWLIST: 특정 도메인이나 이메일만 가입 허용 시 사용 (예: "naver.com,gmail.com")
TEST_EMAIL_ALLOWLIST=
